# Copy to .env (docker compose reads it) or export these variables.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave POSTGRES_HOST empty to use SQLite
POSTGRES_HOST=
POSTGRES_DB=codecheck
POSTGRES_USER=codecheck
POSTGRES_PASSWORD=change-me
